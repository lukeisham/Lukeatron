{
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline-command.sh\""
  },
  "permissions": {
    "allow": [
      "Bash(python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/!AgentMail/scripts/agentmail.py\" *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys,json; d=json.load(sys.stdin); c=d.get('tool_input',{}).get('command',''); print(json.dumps({'hookSpecificOutput':{'hookEventName':'PostToolUse','additionalContext':'AgentMail fetched — route new/unprocessed messages through the !Intake skill (① Project · ② Long-Term memory · ③ LukeatronWiki · ④ Action · ∅ Discard): run !DetermineContext first, then assess the four outcome-axes; fail closed on outgoing.'}})) if ('agentmail.py' in c and 'messages' in c) else None\" 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/System/Tools/teaching-app-family/hook.py\" mark",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/System/Tools/hygiene/hook.py\" mark",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/System/Tools/gitsync/gitsync.py\"",
            "statusMessage": "Bringing this Mac's git up to GitHub",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/System/Apps/LukeatronWiki/ensure-wiki.sh\"",
            "statusMessage": "Ensuring LukeatronWiki is live on :8787"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/System/Apps/ProjectDashboard/ensure-dashboard.sh\"",
            "statusMessage": "Ensuring Project Dashboard is live on :8789"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/System/Tools/teaching-app-family/hook.py\" stop",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/System/Tools/hygiene/hook.py\" stop",
            "timeout": 40
          }
        ]
      }
    ]
  }
}
